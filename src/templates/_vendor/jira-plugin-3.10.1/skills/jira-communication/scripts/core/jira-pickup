"""jira-pickup — sprint-scoped, blocker-aware ticket picker for VGD.

Runs the canonical JQL:
    sprint = 37 AND project = VGD AND status = "To Do"
    AND labels = autonomous ORDER BY rank ASC
then post-filters out issues with any unresolved `is blocked by` link.

Output shape mirrors `jira-search.py query --json`: a JSON array of issues,
each with `key` and `fields`.
"""

import json
import sys
from pathlib import Path

# Shared library import (same pattern as jira-search.py)
_script_dir = Path(__file__).parent
_lib_path = _script_dir.parent / "lib"
if _lib_path.exists():
    sys.path.insert(0, str(_lib_path.parent))

import click

from lib.client import LazyJiraClient
from jira_pickup_lib import pickup


# Constants are hardcoded for the VGD project per VGD-126.
SPRINT_ID = 37
PROJECT = "VGD"
STATUS = "To Do"
LABEL = "autonomous"


@click.command()
@click.option("--env-file", type=click.Path(), help="Environment file path")
@click.option("--profile", "-P", help="Jira profile name from ~/.jira/profiles.json")
@click.option("--max-results", "-n", default=50, type=int, help="Max issues to return")
def cli(env_file: str | None, profile: str | None, max_results: int) -> None:
    """Pick up the next available VGD ticket(s)."""
    client = LazyJiraClient(env_file=env_file, profile=profile)
    issues = pickup(
        client,
        sprint_id=SPRINT_ID,
        project=PROJECT,
        status=STATUS,
        label=LABEL,
        max_results=max_results,
    )
    click.echo(json.dumps(issues, indent=2, default=str))


if __name__ == "__main__":
    cli()
